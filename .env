# Text Editor Settings

# General Settings
DEFAULT_FONT="Courier 14"
DEFAULT_SAVE_LOCATION="/path/to/default/save/location"

# Window Settings
WINDOW_SIZE="1200x700"
WINDOW_POSITION="200+150"

# Theme Settings
NORMAL_MODE_BACKGROUND="white"
NORMAL_MODE_FOREGROUND="black"
DARK_MODE_BACKGROUND="#2f2b2b"
DARK_MODE_FOREGROUND="#BDBDBD"

# Recent Files
RECENT_FILES_LIMIT=10  # Number of recent files to store

# Key Bindings (example)
KEYBINDING_CTRL_A="select_all"
KEYBINDING_CTRL_X="cut_text"
KEYBINDING_F7="run_cpp_script_extra"
KEYBINDING_CTRL_S="save_file_shortcut"

# Other Settings
STACK_SIZE=100  # Maximum size of undo/redo stack
